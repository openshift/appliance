FROM registry.access.redhat.com/ubi9/go-toolset:1.26.7-1791479310 AS builder
COPY go.mod go.mod
COPY go.sum go.sum
COPY pkg/iso-builder/config/go.mod pkg/iso-builder/config/go.mod
RUN go mod download
COPY . .
RUN make build-iso-builder
RUN make build-iso-config-embedder

FROM registry.access.redhat.com/ubi9/ubi-micro:9.7

COPY --from=builder build/openshift-iso-builder /openshift-iso-builder
COPY --from=builder build/iso-config-embedder /iso-config-embedder

LABEL summary="OpenShift ISO Builder" \
      name="openshift-iso-builder" \
      description="Builds OpenShift installation ISOs for disconnected environments" \
      io.k8s.description="Builds OpenShift installation ISOs for disconnected environments" \
      io.k8s.display-name="OpenShift ISO Builder" \
      com.redhat.component="openshift-iso-builder"
